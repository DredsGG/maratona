{
  "manifest_version": 3,
  "name": "Maratona",
  "version": "1.2.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js",
    "scripts": [
      "src/sw.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/novidades.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG/maratona",
  "browser_specific_settings": {
    "gecko": {
      "id": "maratona@dredsgg",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/DredsGG/maratona/main/firefox/updates.json"
    }
  }
}
